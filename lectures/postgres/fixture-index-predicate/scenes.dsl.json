{
  "lecture": "postgres/fixture-index-predicate",
  "scenes": [
    {
      "id": "s01",
      "segment": "seg-01",
      "preset": "hero-tree",
      "slots": {
        "title": "Index path",
        "tree": {
          "id": "btree",
          "nodes": [
            {"id": "root", "label": "root"},
            {"id": "n12", "label": "(12,20]"},
            {"id": "leaf", "label": "predicate"}
          ]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "btree"},
        {"at": {"word": "read"}, "do": "traverse", "target": "btree.node[1]"},
        {"at": {"word": "sequential"}, "do": "emphasize", "target": "btree.node[0]"},
        {"at": {"word": "table"}, "do": "traverse", "target": "btree.node[2]"}
      ],
      "transition": "cut"
    },
    {
      "id": "s02",
      "segment": "seg-02",
      "preset": "hero-table-with-annotation",
      "slots": {
        "title": "Predicate rows",
        "table": {
          "id": "orders",
          "columns": ["id", "status", "total"],
          "rows": [
            ["1", "pending", "42.00"],
            ["2", "shipped", "18.50"],
            ["3", "pending", "9.99"]
          ]
        },
        "annotation": {
          "id": "counter",
          "kind": "counter",
          "label": "Rows scanned",
          "from": 0,
          "to": 3
        }
      },
      "beats": [
        {"at": {"word": "every"}, "do": "reveal", "target": "orders"},
        {"at": {"word": "heap"}, "do": "emphasize", "target": "orders.row[0]"},
        {"at": {"word": "examined"}, "do": "scan-rows", "target": "orders", "drive": "counter"},
        {"at": {"after": "examined", "gap": "short"}, "do": "emphasize", "target": "orders.row[1]"},
        {"at": {"word": "filter"}, "do": "emphasize", "target": "orders.row[2]"},
        {"at": {"word": "reject"}, "do": "deemphasize", "target": "orders.row[2]"}
      ],
      "transition": "morph"
    },
    {
      "id": "s03",
      "segment": "seg-03",
      "preset": "compare-split",
      "slots": {
        "title": "Index vs seq",
        "left": {"id": "idx", "label": "Index Scan"},
        "right": {"id": "seq", "label": "Seq Scan"}
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "idx"},
        {"at": {"word": "plan"}, "do": "reveal", "target": "seq"},
        {"at": {"word": "index"}, "do": "emphasize", "target": "idx"},
        {"at": {"word": "predicate"}, "do": "connect", "from": "idx", "to": "seq"},
        {"at": {"word": "covers"}, "do": "focus", "target": "idx"},
        {"at": {"word": "scan"}, "do": "emphasize", "target": "seq"}
      ],
      "transition": "morph"
    },
    {
      "id": "s04",
      "segment": "seg-04",
      "preset": "metric-callout",
      "slots": {
        "title": "Selectivity",
        "metric": {"id": "io", "value": "Predicate", "unit": "selectivity"}
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "io"},
        {"at": {"word": "matching"}, "do": "emphasize", "target": "io"},
        {"at": {"word": "costs"}, "do": "count", "target": "io"},
        {"at": {"word": "grows"}, "do": "focus", "target": "io"}
      ],
      "transition": "morph"
    },
    {
      "id": "s05",
      "segment": "seg-05",
      "preset": "hero-code-plus-output",
      "slots": {
        "title": "EXPLAIN predicate",
        "code": {
          "id": "code",
          "language": "sql",
          "lines": [
            "EXPLAIN SELECT *",
            "FROM orders",
            "WHERE status = 'pending';"
          ]
        },
        "output": {
          "id": "plan",
          "lines": [
            "Index Scan on orders",
            "  Index Cond: (status = 'pending')",
            "  Filter: (status = 'pending')"
          ]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "code"},
        {"at": {"word": "simple"}, "do": "type-code", "target": "code"},
        {"at": {"word": "every"}, "do": "reveal", "target": "plan"},
        {"at": {"word": "latency"}, "do": "connect", "from": "code", "to": "plan"},
        {"at": {"word": "wide"}, "do": "highlight-lines", "target": "code.line[2]"}
      ],
      "transition": "morph"
    }
  ]
}
