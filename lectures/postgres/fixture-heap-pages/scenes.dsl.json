{
  "lecture": "postgres/fixture-heap-pages",
  "scenes": [
    {
      "id": "s01",
      "segment": "seg-01",
      "preset": "memory-blocks",
      "slots": {
        "title": "Heap pages",
        "blocks": {
          "id": "heap",
          "pages": [
            {"id": "p8", "label": "PAGE 8"},
            {"id": "p7", "label": "PAGE 7"},
            {"id": "p6", "label": "PAGE 6"},
            {"id": "p5", "label": "PAGE 5"},
            {"id": "p4", "label": "PAGE 4"}
          ]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "heap"},
        {"at": {"word": "read"}, "do": "traverse", "target": "heap.page[0]"},
        {"at": {"word": "every"}, "do": "emphasize", "target": "heap.page[1]"},
        {"at": {"word": "row"}, "do": "traverse", "target": "heap.page[2]"},
        {"at": {"word": "table"}, "do": "focus", "target": "heap.page[4]"}
      ],
      "transition": "cut"
    },
    {
      "id": "s02",
      "segment": "seg-02",
      "preset": "hero-table-with-annotation",
      "slots": {
        "title": "Tuple slots",
        "table": {
          "id": "orders",
          "columns": ["id", "status", "total"],
          "rows": [
            ["1", "pending", "42.00"],
            ["2", "shipped", "18.50"],
            ["3", "pending", "9.99"],
            ["4", "shipped", "120.00"]
          ]
        },
        "annotation": {
          "id": "counter",
          "kind": "counter",
          "label": "Tuples / page",
          "from": 0,
          "to": 4
        }
      },
      "beats": [
        {"at": {"word": "every"}, "do": "reveal", "target": "orders"},
        {"at": {"word": "examined"}, "do": "scan-rows", "target": "orders", "drive": "counter"},
        {"at": {"after": "examined", "gap": "short"}, "do": "emphasize", "target": "orders.row[3]"},
        {"at": {"word": "filter"}, "do": "deemphasize", "target": "orders.row[1]"}
      ],
      "transition": "morph"
    },
    {
      "id": "s03",
      "segment": "seg-03",
      "preset": "statement",
      "slots": {
        "statement": "No index on predicate"
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "statement"},
        {"at": {"word": "index"}, "do": "emphasize", "target": "statement"},
        {"at": {"word": "predicate"}, "do": "focus", "target": "statement"},
        {"at": {"word": "scan"}, "do": "deemphasize", "target": "statement"}
      ],
      "transition": "morph"
    },
    {
      "id": "s04",
      "segment": "seg-04",
      "preset": "metric-callout",
      "slots": {
        "title": "Page growth",
        "metric": {"id": "io", "value": "8 KB", "unit": "per page"}
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "io"},
        {"at": {"word": "grows"}, "do": "count", "target": "io"},
        {"at": {"word": "costs"}, "do": "emphasize", "target": "io"}
      ],
      "transition": "morph"
    },
    {
      "id": "s05",
      "segment": "seg-05",
      "preset": "hero-code-plus-output",
      "slots": {
        "title": "Heap access",
        "code": {
          "id": "code",
          "language": "sql",
          "lines": [
            "SELECT ctid, *",
            "FROM orders",
            "LIMIT 4;"
          ]
        },
        "output": {
          "id": "plan",
          "lines": [
            "ctid | id | status",
            "(0,1) | 1 | pending",
            "(0,2) | 2 | shipped"
          ]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "code"},
        {"at": {"word": "simple"}, "do": "type-code", "target": "code"},
        {"at": {"word": "latency"}, "do": "connect", "from": "code", "to": "plan"},
        {"at": {"word": "wide"}, "do": "highlight-lines", "target": "code.line[1]"}
      ],
      "transition": "morph"
    }
  ]
}
