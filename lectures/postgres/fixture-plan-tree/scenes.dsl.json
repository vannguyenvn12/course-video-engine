{
  "lecture": "postgres/fixture-plan-tree",
  "scenes": [
    {
      "id": "s01",
      "segment": "seg-01",
      "preset": "hero-graph",
      "slots": {
        "title": "Plan graph",
        "graph": {
          "id": "plan",
          "nodes": [
            {"id": "n1", "label": "Seq Scan"},
            {"id": "n2", "label": "Filter"}
          ],
          "edges": [["n1", "n2"]]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "plan"},
        {"at": {"word": "read"}, "do": "draw", "target": "plan.edge[0]"},
        {"at": {"word": "sequential"}, "do": "emphasize", "target": "plan.node[0]"},
        {"at": {"word": "table"}, "do": "traverse", "target": "plan.node[1]"}
      ],
      "transition": "cut"
    },
    {
      "id": "s02",
      "segment": "seg-02",
      "preset": "hero-table-with-annotation",
      "slots": {
        "title": "Heap rows",
        "table": {
          "id": "orders",
          "columns": ["id", "status", "total"],
          "rows": [
            ["1", "pending", "42.00"],
            ["2", "shipped", "18.50"],
            ["3", "pending", "9.99"]
          ]
        },
        "annotation": {
          "id": "counter",
          "kind": "counter",
          "label": "Rows scanned",
          "from": 0,
          "to": 3
        }
      },
      "beats": [
        {"at": {"word": "every"}, "do": "reveal", "target": "orders"},
        {"at": {"word": "examined"}, "do": "scan-rows", "target": "orders", "drive": "counter"},
        {"at": {"after": "heap", "gap": "short"}, "do": "focus", "target": "counter"},
        {"at": {"word": "filter"}, "do": "emphasize", "target": "orders.row[2]"},
        {"at": {"word": "reject"}, "do": "deemphasize", "target": "orders.row[2]"}
      ],
      "transition": "morph"
    },
    {
      "id": "s03",
      "segment": "seg-03",
      "preset": "lanes-timeline",
      "slots": {
        "title": "Planner lanes",
        "lanes": [
          {"id": "parse", "label": "Parse"},
          {"id": "plan", "label": "Plan"},
          {"id": "exec", "label": "Execute"}
        ]
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "parse"},
        {"at": {"word": "plan"}, "do": "emphasize", "target": "plan"},
        {"at": {"word": "sequential"}, "do": "traverse", "target": "exec"},
        {"at": {"word": "scan"}, "do": "draw", "target": "parse"},
        {"at": {"word": "index"}, "do": "deemphasize", "target": "parse"}
      ],
      "transition": "morph"
    },
    {
      "id": "s04",
      "segment": "seg-04",
      "preset": "metric-callout",
      "slots": {
        "title": "Plan cost",
        "metric": {"id": "io", "value": "Planner", "unit": "cost units"}
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "io"},
        {"at": {"word": "matching"}, "do": "emphasize", "target": "io"},
        {"at": {"word": "costs"}, "do": "count", "target": "io"},
        {"at": {"word": "grows"}, "do": "focus", "target": "io"}
      ],
      "transition": "morph"
    },
    {
      "id": "s05",
      "segment": "seg-05",
      "preset": "hero-code-plus-output",
      "slots": {
        "title": "EXPLAIN plan",
        "code": {
          "id": "code",
          "language": "sql",
          "lines": [
            "EXPLAIN (VERBOSE)",
            "SELECT * FROM orders",
            "WHERE status = 'pending';"
          ]
        },
        "output": {
          "id": "plan",
          "lines": [
            "Hash",
            "  -> Seq Scan on orders",
            "        Filter: (status = 'pending')"
          ]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "code"},
        {"at": {"word": "simple"}, "do": "type-code", "target": "code"},
        {"at": {"word": "every"}, "do": "reveal", "target": "plan"},
        {"at": {"word": "latency"}, "do": "connect", "from": "code", "to": "plan"}
      ],
      "transition": "morph"
    }
  ]
}
