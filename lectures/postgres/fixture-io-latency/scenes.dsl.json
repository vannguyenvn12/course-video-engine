{
  "lecture": "postgres/fixture-io-latency",
  "scenes": [
    {
      "id": "s01",
      "segment": "seg-01",
      "preset": "warning-callout",
      "slots": {
        "title": "IO bound",
        "warning": "Every page from disk"
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "warning"},
        {"at": {"word": "read"}, "do": "emphasize", "target": "warning"},
        {"at": {"word": "sequential"}, "do": "focus", "target": "warning"},
        {"at": {"word": "table"}, "do": "deemphasize", "target": "warning"}
      ],
      "transition": "cut"
    },
    {
      "id": "s02",
      "segment": "seg-02",
      "preset": "memory-blocks",
      "slots": {
        "title": "Buffer pages",
        "blocks": {
          "id": "heap",
          "pages": [
            {"id": "p8", "label": "BUF 8"},
            {"id": "p7", "label": "BUF 7"},
            {"id": "p6", "label": "BUF 6"}
          ]
        }
      },
      "beats": [
        {"at": {"word": "every"}, "do": "reveal", "target": "heap"},
        {"at": {"word": "heap"}, "do": "traverse", "target": "heap.page[0]"},
        {"at": {"word": "examined"}, "do": "traverse", "target": "heap.page[1]"},
        {"at": {"after": "row", "gap": "short"}, "do": "emphasize", "target": "heap.page[2]"},
        {"at": {"word": "filter"}, "do": "focus", "target": "heap.page[1]"}
      ],
      "transition": "morph"
    },
    {
      "id": "s03",
      "segment": "seg-03",
      "preset": "compare-split",
      "slots": {
        "title": "Latency split",
        "left": {"id": "cold", "label": "Cold cache"},
        "right": {"id": "warm", "label": "Warm cache"}
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "cold"},
        {"at": {"word": "plan"}, "do": "reveal", "target": "warm"},
        {"at": {"word": "sequential"}, "do": "emphasize", "target": "cold"},
        {"at": {"word": "scan"}, "do": "connect", "from": "cold", "to": "warm"},
        {"at": {"word": "index"}, "do": "deemphasize", "target": "warm"}
      ],
      "transition": "morph"
    },
    {
      "id": "s04",
      "segment": "seg-04",
      "preset": "metric-callout",
      "slots": {
        "title": "IO latency",
        "metric": {"id": "io", "value": "ms", "unit": "per page"}
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "io"},
        {"at": {"word": "costs"}, "do": "count", "target": "io"},
        {"at": {"word": "grows"}, "do": "emphasize", "target": "io"},
        {"at": {"word": "matching"}, "do": "focus", "target": "io"}
      ],
      "transition": "morph"
    },
    {
      "id": "s05",
      "segment": "seg-05",
      "preset": "hero-code-plus-output",
      "slots": {
        "title": "Wide rows",
        "code": {
          "id": "code",
          "language": "sql",
          "lines": [
            "EXPLAIN SELECT *",
            "FROM orders",
            "WHERE status = 'pending';"
          ]
        },
        "output": {
          "id": "plan",
          "lines": [
            "Seq Scan on orders",
            "  I/O Timings: read=12ms",
            "  Rows Removed by Filter: 900"
          ]
        }
      },
      "beats": [
        {"at": {"segmentStart": true}, "do": "reveal", "target": "code"},
        {"at": {"word": "latency"}, "do": "connect", "from": "code", "to": "plan"},
        {"at": {"word": "wide"}, "do": "highlight-lines", "target": "code.line[2]"},
        {"at": {"word": "every"}, "do": "reveal", "target": "plan"}
      ],
      "transition": "morph"
    }
  ]
}
